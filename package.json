{
  "name": "caderno-r1",
  "productName": "Pulse",
  "version": "1.5.0",
  "description": "Banco de questões, listas, simulados e desempenho para residência médica, com sincronização pela conta Google.",
  "author": "Guilherme",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:win:admin": "electron-builder --win portable --publish never --config electron-builder.admin.json",
    "android:add": "cap add android",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor #4338A8 --iconBackgroundColorDark #4338A8 --splashBackgroundColor #F4F4F9 --splashBackgroundColorDark #0B0B12",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "br.cadernor1.app",
    "productName": "Pulse",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "www/**/*", "package.json"],
    "win": {
      "target": ["portable"],
      "icon": "icon-1024.png"
    },
    "portable": {
      "artifactName": "Pulse-Portatil-${version}.${ext}"
    }
  }
}
